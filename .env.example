# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
#   cp .env.example .env.local
#
# chat-api loads .env.local from the repo root at boot, whichever package the
# process was started from. Everything except the key has a working default, so
# a .env.local containing only ANTHROPIC_API_KEY is enough.

# The one value you have to supply. Not needed with MODEL_PROVIDER=mock.
ANTHROPIC_API_KEY=sk-ant-...

# --- model gateway (defaults shown) -----------------------------------------
# mock skips the network entirely — no key, no cost.
# MODEL_PROVIDER=anthropic
# MODEL_ID=claude-haiku-4-5
# Tried once if MODEL_ID fails retryably. `none` disables it.
# MODEL_FALLBACK_ID=claude-sonnet-5
# A ceiling on the reply, not a target.
# MODEL_MAX_TOKENS=4096
# MODEL_TIMEOUT_MS=60000
# MODEL_MAX_RETRIES=2
# Prints each message array sent and the text returned. 0 to silence.
# MODEL_LOG_PAYLOADS=1
# Also print the raw HTTP exchange with the provider — URL, headers, both JSON
# bodies. Verbose; credentials are redacted.
# MODEL_LOG_WIRE=1

# --- chat-api (defaults shown) ----------------------------------------------
# PORT=3001
# CORS_ORIGINS=http://localhost:5173
# DATABASE_URL=./data/chat.sqlite
# CONTEXT_WINDOW_TURNS=10
